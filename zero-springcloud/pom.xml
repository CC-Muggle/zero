<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.github</groupId>
		<artifactId>zero</artifactId>
		<version>1.0.0</version>
	</parent>
	<artifactId>zero-springcloud</artifactId>
	<packaging>pom</packaging>
	<!-- 注意：Spring Cloud 2023.0.x 移除了 Netflix Zuul/Hystrix/Ribbon。zuul/ribbon/hystrix 模块需手动迁移：Zuul→Gateway, Hystrix→Resilience4j, Ribbon→LoadBalancer -->
	<modules>
		<module>zero-springcloud-eureka</module>
		<module>zero-springcloud-service-provider</module>
		<module>zero-springcloud-service-consumer</module>
		<!-- <module>zero-springcloud-ribbon</module> -->
		<!-- <module>zero-springcloud-zuul</module> -->
		<!-- <module>zero-springcloud-hystrix</module> -->
		<module>zero-springcloud-feign</module>
	</modules>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.github</groupId>
				<artifactId>zero-springcloud-ribbon</artifactId>
				<version>${project.parent.version}</version>
			</dependency>
			<dependency>
				<groupId>com.github</groupId>
				<artifactId>zero-springcloud-feign</artifactId>
				<version>${project.parent.version}</version>
			</dependency>
			<dependency>
				<groupId>com.github</groupId>
				<artifactId>zero-springcloud-hystrix</artifactId>
				<version>${project.parent.version}</version>
			</dependency>
			<dependency>
				<groupId>com.github</groupId>
				<artifactId>zero-springcloud-zuul</artifactId>
				<version>${project.parent.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>
</project>